BOT_TOKEN=your_telegram_bot_token_here

# LLM provider: groq | anthropic | ollama
LLM_PROVIDER=groq

# API key for the chosen provider:
#   groq      → get free key at console.groq.com
#   anthropic → get key at console.anthropic.com
#   ollama    → any non-empty string (e.g. "ollama")
LLM_API_KEY=your_llm_api_key_here

# Model name (leave empty to use provider default):
#   groq default:      llama-3.3-70b-versatile
#   anthropic default: claude-haiku-4-5-20251001
#   ollama default:    llama3
LLM_MODEL=

DATABASE_PATH=data/bot.db
GDRIVE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
GDRIVE_BACKUP_FOLDER_ID=your_google_drive_folder_id

# Telegram chat where DB backups are sent (use /chatid to get it)
# Leave empty to send backup to the same chat where /backup was called
BACKUP_CHAT_ID=
SNOOZE_EVENING_HOUR=19
SNOOZE_MORNING_HOUR=9
ESCALATION_SNOOZE_COUNT=3
